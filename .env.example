# 이 파일은 템플릿입니다. 복사해서 .env 를 만든 뒤 실제 값을 채우세요.
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 커밋되지 않습니다. 실제 키를 이 파일에 적지 마세요.

# Gemini API 키 (필수)
GEMINI_API_KEY=your_api_key_here

# 사용할 모델 (선택) — 지정하지 않으면 코드 기본값 gemini-3.6-flash 를 사용합니다.
GEMINI_MODEL=gemini-3.6-flash
